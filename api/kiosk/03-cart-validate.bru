meta {
  name: Kiosk Cart Validate
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/kiosk/cart/validate
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "items": [
      {
        "menuId": {{menuId}},
        "quantity": 1,
        "optionItems": [
          { "optionItemId": 269, "quantity": 1 }
        ],
        "excludedIngredientIds": []
      }
    ]
  }
}

docs {
  # API-004
  POST /api/kiosk/cart/validate
  응답 code: OK (ApiResponse.success(data) 기본값)
  요청 옵션: items[].optionItems[].{optionItemId, quantity}
  요청 재료 제외: items[].excludedIngredientIds
  응답: totalAmount, items[].{clientCartItemId, menuId, quantity, unitPrice, optionItems, excludedIngredientIds}
}
