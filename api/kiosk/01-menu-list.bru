meta {
  name: Kiosk Menu List
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/kiosk/menuList
  body: none
  auth: none
}

docs {
  # API-002
  GET /api/kiosk/menuList
  UserMenuController 는 categoryId query 를 받지 않는다. 전체 목록 + categories 를 함께 반환.
  응답 code: OK (ApiResponse.success(data) 기본값)
  data: { categories, menus[] }
  menus[]: menuId, categoryId, name, price, imageUrl, kcal, isSoldOut, isOrderable
}
