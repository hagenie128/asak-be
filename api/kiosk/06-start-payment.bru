meta {
  name: Kiosk Start Payment
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/api/kiosk/payments
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "orderId": {{orderId}},
    "orderStatus": "RECEIVED",
    "paymentMethodCode": "TOSS_PAY",
    "idempotencyKey": "uuid",
    "tossPayment": {
      "paymentKey": "tgen_20260819...",
      "orderId": "A202607230001",
      "amount": 8900
    }
  }
}

docs {
  # API-006
  POST /api/kiosk/payments
  응답 code: KIOSK_PAYMENT_APPROVED
  CARD 요청: orderId, orderStatus(=RECEIVED), paymentMethodCode(=CARD), idempotencyKey
  토스 간편결제 요청: orderId, orderStatus(=RECEIVED), paymentMethodCode, idempotencyKey, tossPayment
  tossPayment: paymentKey, orderId(토스페이먼츠 주문번호), amount
  실행 전 idempotencyKey, paymentKey, tossPayment.orderId, amount를 실제 결제값으로 교체
  data: paymentId, orderId, orderNo, paymentMethodCode, paymentStatus(=APPROVED),
        orderStatus(=RECEIVED), approvedAmount, approvedAt, waitingOrderCount
  레거시 amount/paidAt 사용 금지
}
