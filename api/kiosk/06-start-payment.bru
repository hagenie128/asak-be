meta {
  name: Kiosk Start Payment
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/api/kiosk/payments
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "orderId": {{orderId}},
    "orderStatus": "READY",
    "paymentMethodCode": "CARD",
    "idempotencyKey": "bruno-local-replace-me"
  }
}

docs {
  # API-006
  POST /api/kiosk/payments
  응답 code: KIOSK_PAYMENT_APPROVED
  body: orderId, orderStatus(=READY), paymentMethodCode, idempotencyKey
  data: paymentId, orderId, orderNo, paymentStatus, approvedAmount, approvedAt, waitingOrderCount
  레거시 amount/paidAt 사용 금지
}
