meta {
  name: Kiosk Start Payment
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/api/kiosk/payments
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "orderId": {{orderId}},
    "paymentMethodCode": "CARD",
    "idempotencyKey": "bruno-local-replace-me"
  }
}

docs {
  # API-006
  POST /api/kiosk/payments
  PAYMENT_API_CONTRACT.md
  DB view: vw_payment_result
  응답: paymentId, orderId, orderNo, paymentStatus,
        approvedAmount, approvedAt, waitingOrderCount
  waitingOrderCount는 조회 시점 RECEIVED/PREPARING 건수 (상관 서브쿼리)
  레거시 amount/paidAt 사용 금지
  SPEC_ONLY: 현재 결제 Controller mapping 미구현
}
