meta {
  name: Health Check
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/health
  body: none
  auth: none
}

docs {
  # Health
  GET /api/health
  응답 code: HEALTH_OK
  data: { service: "ASAK-backend" }
  성공 assert는 이 요청만 유지한다.
}

tests {
  test("HTTP 200", function() {
    expect(res.getStatus()).to.equal(200);
  });

  test("ApiResponse envelope", function() {
    const body = res.getBody();
    expect(body.success).to.equal(true);
    expect(body.status).to.equal(200);
    expect(body.code).to.equal("HEALTH_OK");
    expect(body).to.have.property("message");
    expect(body.data).to.have.property("service", "ASAK-backend");
  });
}
