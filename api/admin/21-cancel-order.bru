meta {
  name: Admin Cancel Order
  type: http
  seq: 21
}

patch {
  url: {{baseUrl}}/api/admin/orders/{{orderId}}/cancel
  body: none
  auth: none
}

docs {
  # API-024
  PATCH /api/admin/orders/{orderId}/cancel
  RECEIVED/PREPARING만 가능 → CANCELED
  승인 결제는 REFUNDED + refundedAt
  불가 시 409 ORDER_CANCEL_NOT_ALLOWED
  응답 code: ADMIN_ORDER_CANCEL_SUCCESS
  IMPLEMENTED: AdminOrderController PatchMapping /{orderId}/cancel
}
