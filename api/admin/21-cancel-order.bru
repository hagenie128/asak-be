meta {
  name: Admin Cancel Order
  type: http
  seq: 21
}

patch {
  url: {{baseUrl}}/api/admin/orders/{{orderId}}/cancel
  body: none
  auth: none
}

docs {
  # API-024
  PATCH /api/admin/orders/{orderId}/cancel
  RECEIVED/PREPARING 이고 결제가 APPROVED 가 아닐 때만 CANCELED
  APPROVED 결제는 취소하지 않고 409 ORDER_CANCEL_NOT_ALLOWED
  응답 code: ADMIN_ORDER_CANCEL_SUCCESS
}
