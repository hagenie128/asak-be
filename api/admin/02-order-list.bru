meta {
  name: Admin Order List
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/api/admin/orders?page=0&size=20
  body: none
  auth: none
}

docs {
  # API-007
  GET /api/admin/orders
  query: page, size, orderStatus, paymentStatus, orderType, dateFrom, dateTo, keyword
  기본 page=0 size=20
  dateFrom / dateTo 는 LocalDate. 빈 문자열을 넣으면 400 이므로 미사용 시 생략.
  응답 code: ADMIN_ORDER_LIST_SUCCESS
  행: orderId, orderNo, orderType, orderStatus, paymentStatus, totalAmount, createdAt, itemCount, menuSummary
}
