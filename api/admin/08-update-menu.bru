meta {
  name: Admin Update Menu
  type: http
  seq: 8
}

patch {
  url: {{baseUrl}}/api/admin/menus/{{menuId}}
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "categoryId": {{categoryId}},
    "name": "Bruno Sample Menu Updated",
    "price": 9200,
    "description": "Bruno contract sample menu (PATCH)",
    "ingredients": [
      {
        "ingredientId": 143,
        "role": "core",
        "quantity": 0,
        "unit": "G",
        "isDefault": true,
        "canRemove": false
      },
      {
        "ingredientId": 223,
        "role": "default",
        "quantity": 50,
        "unit": "G",
        "isDefault": true,
        "canRemove": true
      }
    ],
    "optionGroups": [
      {
        "optionGroupId": {{optionGroupId}},
        "isRequired": true,
        "recommendedOptionItemId": {{recommendedOptionItemId}},
        "items": [
          { "optionItemId": 265, "isRecommended": false },
          { "optionItemId": {{recommendedOptionItemId}}, "isRecommended": true }
        ]
      }
    ],
    "nutrition": {
      "kcal": 330,
      "carbG": 13,
      "proteinG": 15,
      "fatG": 18,
      "sodiumMg": 420
    },
    "tags": [
      { "code": "NEW", "name": "NEW" }
    ]
  }
}

docs {
  # API-013
  PATCH /api/admin/menus/{menuId}
  Content-Type: application/json
  body: CreateMenuRequest (등록과 동일 shape)
  응답 code: ADMIN_MENU_UPDATE_SUCCESS

  부분 갱신:
  - ingredients / optionGroups / nutrition / tags 가 null 이 아니면
    해당 자식 테이블을 삭제 후 재삽입한다.
  - optionGroups 는 AdminOptionService.replaceMenuOptionGroups 만 사용한다.
  - imageUrl 은 media_asset.url 에 있을 때만. 없으면 생략. mediaAssetId 우선.
}
