<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<!-- TODO-018: sales summary/monthly/daily + dashboard SELECT를 구현한다.
  날짜 parameter와 주문 상태·시간대 기준은 AdminStatsController/Service와 동일하게 유지하고,
  DTO camelCase에 맞는 column alias/resultMap을 사용한다. view 사용 시 실제 정의·빈 기간·성능을 검증한다. -->
<mapper namespace="com.asak.admin.mapper.AdminSalesMapper">

  <select id="getSalesSummary" resultType="com.asak.admin.dto.response.sales.DailySalesSummaryItemResponse">
    SELECT * FROM vw_sales_daily
    <if test="dateRange != null">
      WHERE sales_date BETWEEN #{dateRange.startDate} AND #{dateRange.endDate}
    </if>
  </select>

  <select id="getSalesHourly" resultType="com.asak.admin.dto.response.sales.HourlySalesSummaryItemResponse">
    SELECT * FROM vw_sales_hourly
    WHERE sales_date = #{date}
  </select>

  <select id="getDailyTopMenu" resultType="com.asak.admin.dto.response.sales.DailyTopMenuResponse">
    SELECT * FROM vw_top_menu_daily
    WHERE sales_date = #{date}
  </select>

  <select id="getHourlyTopMenu" resultType="com.asak.admin.dto.response.sales.HourlyTopMenuResponse">
    SELECT * FROM vw_top_menu_hourly
    WHERE sales_date = #{date}
  </select>
</mapper>
